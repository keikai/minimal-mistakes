{% assign navigation = site.data.navigation[include.nav] %}

<nav class="nav__list">
  {% if page.sidebar.title %}
    <h3 class="nav__title" style="padding-left: 0;">{{ page.sidebar.title }}</h3>
  {% endif %}
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    {% assign stripped_page_url = page.url | remove: ".html" %}
    <span id="pageurl" style="display:none;">{{ page.url }}</span>
    {% for nav in navigation %}
    {% if nav.url == stripped_page_url %}
      {% assign page_title = nav.title %}
    {% endif %}
      <li>
        {% if nav.url %}
          <a href="{{ nav.url | relative_url }}"><span class="nav__sub-title level1 {% if nav.url == stripped_page_url %}active{% endif %}">{{ nav.title }}</span></a>
        {% else %}
          <span class="nav__sub-title level1">{{ nav.title }}</span>
        {% endif %}

        {% if nav.children != null %}
        <ul>
          {% for child in nav.children %}
            {% if child.url == stripped_page_url %}
              {% assign page_title = child.title %}
            {% endif %}
            <li>
              <a href="{{ child.url | relative_url }}"class="level2 {% if child.url == stripped_page_url %}active{% endif %}">{{ child.title }}</a>
              {% if child.children != null %}
              <ul>
                {% for grandchild in child.children %}
                  {% if grandchild.url == stripped_page_url %}
                    {% assign page_title = grandchild.title %}
                  {% endif %}
                  <li>
                    <a href="{{ grandchild.url | relative_url }}" class="level3 {% if grandchild.url == stripped_page_url %}active{% endif %}">{{ grandchild.title }}</a>
                  </li>
                {% endfor %}
              </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
